<header><div><small>UPSA · CENTRO DE SOPORTE</small><h1>Alerta360 <span style="font-weight:400;opacity:.6">/ mapa</span></h1></div><a href="https://maps.upsa.edu.bo/" target="_blank" rel="noopener">Abrir mapa oficial ↗</a></header>
<main><section aria-label="Mapa de incidencias"><div class="toolbar"><button id="campus" type="button">Campus UPSA</button><button id="grafo" type="button">Zonas de atención 0–7</button><button id="refresh" type="button">Actualizar</button><span class="muted" id="sync">Datos de tu sesión de consola</span></div><div class="map-shell"><div class="map-heading"><div><h2 id="map-title">Zonas del campus</h2><p id="map-subtitle" class="muted"></p></div><span class="tag" id="total"></span></div><svg id="map" class="map-canvas" role="group" aria-label="Campus con zonas numeradas y ubicaciones de incidencias"></svg><div class="legend"><span><i class="dot" style="background:#165c46"></i>Zona seleccionada</span><span><i class="dot" style="background:#c54536"></i>Incidencia activa</span><span><i class="dot" style="background:#cc5b31"></i>Ruta registrada en el grafo</span></div></div><div class="zone-list" id="zones" aria-label="Zonas numeradas"></div><p class="note" id="disclaimer"></p></section><aside><section class="panel"><h2>Buscar un lugar</h2><label for="search">Nombre, bloque o número del lugar</label><input id="search" placeholder="Ej.: biblioteca, bloque D, 173"><label for="locations">Ubicaciones del catálogo oficial</label><select id="locations" style="width:100%" aria-label="Elegir ubicación"></select><p class="note" id="placeId-info"></p></section><section class="panel"><h2>Incidencias <span id="count"></span></h2><label for="state">Mostrar</label><select id="state" style="width:100%"><option value="activas">Activas</option><option value="todas">Todas</option><option>RECIBIDA</option><option>PENDIENTE</option><option>ASIGNADA</option><option>RESUELTA</option><option>CANCELADA</option></select><div id="incidents" class="incidents"></div></section><section class="panel detail-panel"><div id="detail" class="detail" aria-live="polite"></div></section></aside></main><footer>Posiciones: mapa interactivo UPSA · Los números 1–10 identifican áreas visuales; los ID #1–#205 identifican lugares. Las zonas 0–7 pertenecen al grafo del proyecto.</footer>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('datos').textContent), S=DATA.sistema, places=DATA.campus;
const $=id=>document.getElementById(id), NS='http://www.w3.org/2000/svg';
const active=i=>!['RESUELTA','CANCELADA'].includes(i.estado);
const pmap=new Map(places.map(p=>[p.id,p]));
const zoneData=[
{n:1,name:'Bloque Central',x:-13313591,y:898317,block:'Bloque Central'},
{n:2,name:'Bloque A',x:-3236421,y:2755693,block:'Bloque A'},
{n:3,name:'Bloque B',x:-10711351,y:5074487,block:'Bloque B'},
{n:4,name:'Bloque C',x:11308551,y:2770711,block:'Bloque C'},
{n:5,name:'Bloque D',x:13206635,y:3915432,block:'Bloque D'},
{n:6,name:'Bloque E',x:14322005,y:5627622,block:'Bloque E'},
{n:7,name:'Polideportivo',place:49}, {n:8,name:'Cancha de fútbol',place:51},
{n:9,name:'Centro de Convenciones',place:46}, {n:10,name:'Ingreso peatonal',place:185}];
zoneData.forEach(z=>{if(z.place){const p=pmap.get(z.place);z.x=p.x;z.y=p.y;}});
let mode='campus', selected=0, placeId=0, zone=0;
try {const saved=JSON.parse(localStorage.getItem('alerta360-map')||'{}');mode=saved.mode==='grafo'?'grafo':'campus';selected=Number(saved.selected)||0;placeId=Number(saved.placeId)||0;zone=Number(saved.zone)||0;$('state').value=saved.state||'activas';}catch{}
const save=()=>{try{localStorage.setItem('alerta360-map',JSON.stringify({mode,selected,placeId,zone,state:$('state').value}));}catch{}};
const node=(name,attrs={},text)=>{const e=document.createElementNS(NS,name);Object.entries(attrs).forEach(([k,v])=>e.setAttribute(k,v));if(text!==undefined)e.textContent=text;return e;};
const add=(name,attrs,text)=>{const e=node(name,attrs,text);$('map').append(e);return e;};
const pos=(x,y)=>[(x+20037508.342789244)/40075016.68557849*1200,(20037508.342789244-y)/40075016.68557849*1200];
const graph=[[90,280],[280,110],[280,320],[500,130],[650,310],[790,90],[865,320],[1050,160]];
let markerScale=1,placed=[];
function buttonMap(label,x,y,number,fn,chosen=false,kind='zone'){
const ox=x,oy=y,r=(kind==='zone'?18:17)*markerScale;
for(let attempt=0;placed.some(p=>Math.hypot(p.x-x,p.y-y)<p.r+r+5*markerScale)&&attempt<120;attempt++){const angle=attempt*2.4,d=(12+attempt*1.2)*markerScale;x=ox+Math.cos(angle)*d;y=oy+Math.sin(angle)*d;}
placed.push({x,y,r});
if(x!==ox||y!==oy)add('line',{x1:ox,y1:oy,x2:x,y2:y,stroke:'#879d8c','stroke-width':markerScale});
const g=add('g',{role:'button',tabindex:0,'aria-label':label});
g.append(node('title',{},label));g.append(node('circle',{cx:x,cy:y,r,class:chosen?'chosen':kind}));
g.append(node('text',{x,y:y+5*markerScale,'text-anchor':'middle','font-size':(kind==='zone'?14:11)*markerScale,'font-weight':600,fill:chosen||kind!=='zone'?'white':'#174936'},number));
g.addEventListener('click',fn);g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();fn();}});return g;}
function choosePlace(id){placeId=Number(id);selected=0;zone=0;mode='campus';save();render();}
function detail(){
const box=$('detail');box.replaceChildren();const i=S.incidencias.find(i=>i.id===selected), p=pmap.get(placeId);
const title=document.createElement('h3');title.textContent=i?'Incidencia #'+i.id:p?'Lugar #'+p.id:'Ubicá el problema';box.append(title);
if(i){const desc=document.createElement('p');desc.textContent=i.descripcion;box.append(desc);const dl=document.createElement('dl');
[['Estado',i.estado],['Gravedad',i.gravedad||'Sin clasificar'],['Zona de atención',i.zona+' · '+S.zonas[i.zona]],['Lugar UPSA',i.ubicacion&&pmap.has(i.ubicacion)?'#'+i.ubicacion+' · '+pmap.get(i.ubicacion).nombre:'Sin ubicación exacta'],['Ruta',i.ruta.length?i.ruta.join(' → ')+' · '+i.costo+' min (registrados)':'Aún no asignada']].forEach(([k,v])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=k;dd.textContent=v;dl.append(dt,dd);});box.append(dl);
if(!i.ubicacion){const p=document.createElement('p');p.className='action';p.textContent='En la consola: opción 12 → ID '+i.id+' → número del lugar UPSA.';box.append(p);}}
else if(p){const text=document.createElement('p');text.textContent=[p.nombre,p.bloque,p.planta].filter(Boolean).join(' · ');box.append(text);const hint=document.createElement('p');hint.className='action';hint.textContent=p.posicion?'Para marcar una incidencia aquí, elegí la opción 12 en la consola y el lugar '+p.id+'.':'El catálogo no publica una posición para este lugar.';box.append(hint);}
else{const p=document.createElement('p');p.textContent='Seleccioná una zona numerada, un lugar del catálogo o una incidencia para ver el detalle.';box.append(p);}
}
function renderLocations(){const text=$('search').value.toLocaleLowerCase('es');const select=$('locations');select.replaceChildren();const first=document.createElement('option');first.value='0';first.textContent='Seleccionar lugar…';select.append(first);places.filter(p=>`${p.id} ${p.nombre} ${p.bloque} ${p.planta}`.toLocaleLowerCase('es').includes(text)).forEach(p=>{const o=document.createElement('option');o.value=p.id;o.textContent='#'+p.id+' · '+p.nombre+(p.planta?' · '+p.planta:'')+(p.posicion?'':' (sin posición)');select.append(o);});select.value=String(placeId);}
function render(){
$('campus').setAttribute('aria-pressed',mode==='campus');$('grafo').setAttribute('aria-pressed',mode==='grafo');$('map').replaceChildren();$('zones').replaceChildren();placed=[];markerScale=Math.max(1,1120/$('map').clientWidth);
const filtered=S.incidencias.filter(i=>$('state').value==='todas'||($('state').value==='activas'?active(i):i.estado===$('state').value));
$('sync').textContent=S.incidencias.length&&S.incidencias.every(i=>i.descripcion.startsWith('DEMO:'))?'Demostración · incidencias de ejemplo':'Datos de tu sesión de consola';$('total').textContent=S.incidencias.filter(active).length+' activas';$('count').textContent='('+filtered.length+')';$('incidents').replaceChildren();
filtered.forEach(i=>{const b=document.createElement('button');b.className='incident';b.setAttribute('aria-pressed',selected===i.id);const title=document.createElement('strong');title.textContent='#'+i.id+' · Zona '+i.zona;const sub=document.createElement('div');sub.className='muted';sub.textContent=i.estado+' · gravedad '+(i.gravedad||'—')+(i.ubicacion?' · lugar #'+i.ubicacion:'');b.append(title,sub);b.onclick=()=>{selected=i.id;placeId=i.ubicacion;zone=0;save();render();};$('incidents').append(b);});
if(!filtered.length){const e=document.createElement('p');e.className='empty';e.textContent='No hay incidencias en este filtro.';$('incidents').append(e);}
const current=S.incidencias.find(i=>i.id===selected);
if(mode==='campus'){
$('map-title').textContent='Campus UPSA · zonas numeradas';$('map-subtitle').textContent='Posiciones del catálogo oficial · referencia espacial';$('map').setAttribute('viewBox','35 330 1120 540');
// Sombreado de areas de bloques: agrupacion de puntos del catalogo, no huellas de edificios.
zoneData.filter(z=>z.block).forEach(z=>{const pts=places.filter(p=>p.posicion&&p.bloque===z.block);if(!pts.length)return;const pp=pts.map(p=>pos(p.x,p.y));const xs=pp.map(p=>p[0]),ys=pp.map(p=>p[1]);add('rect',{x:Math.min(...xs)-14,y:Math.min(...ys)-14,width:Math.max(...xs)-Math.min(...xs)+28,height:Math.max(...ys)-Math.min(...ys)+28,rx:20,fill:'#d8e6d8',stroke:'#b4cab8','stroke-dasharray':'5 6'});});
places.filter(p=>p.posicion).forEach(p=>{const [x,y]=pos(p.x,p.y);add('circle',{cx:x,cy:y,r:2.2,fill:'#8aa78f'});});
zoneData.forEach(z=>{const [x,y]=pos(z.x,z.y);buttonMap('Zona visual '+z.n+': '+z.name,x,y,z.n,()=>{zone=z.n;placeId=z.place||0;selected=0;save();render();},zone===z.n);});
filtered.filter(i=>i.ubicacion&&pmap.get(i.ubicacion)?.posicion).forEach(i=>{const p=pmap.get(i.ubicacion),[x,y]=pos(p.x,p.y);const same=filtered.filter(j=>j.ubicacion===i.ubicacion),idx=same.indexOf(i);const offset=(idx-(same.length-1)/2)*30;add('line',{x1:x,y1:y,x2:x+offset,y2:y-30,stroke:'#c54536','stroke-width':2});buttonMap('Incidencia #'+i.id+' en '+p.nombre,x+offset,y-30,i.id,()=>{selected=i.id;placeId=i.ubicacion;save();render();},selected===i.id,'alert-pin');});
if(placeId&&pmap.get(placeId)?.posicion){const p=pmap.get(placeId),[x,y]=pos(p.x,p.y);add('circle',{cx:x,cy:y,r:29,fill:'none',stroke:'#bc632b','stroke-width':3});add('title',{},'#'+p.id+' '+p.nombre);}
zoneData.forEach(z=>zoneButton(z.n,z.name,()=>{zone=z.n;selected=0;placeId=z.place||0;save();render();}));
$('disclaimer').textContent='Los círculos numerados identifican 10 áreas visuales. Los contornos agrupan ubicaciones y no representan edificios ni caminos. El fondo gráfico del sitio oficial no está disponible; se conservan sus posiciones originales. Las incidencias sin lugar exacto se ven en “Zonas de atención 0–7”.';
}else{
$('map-title').textContent='Zonas de atención · 0 a 7';$('map-subtitle').textContent='Grafo del proyecto · conexiones en minutos';$('map').setAttribute('viewBox','0 0 1150 440');
S.aristas.forEach(([a,b,c])=>{const [x1,y1]=graph[a],[x2,y2]=graph[b];add('line',{x1,y1,x2,y2,class:'edge'});add('text',{x:(x1+x2)/2,y:(y1+y2)/2-7,'text-anchor':'middle','font-size':12*markerScale,fill:'#546d5d'},c+' min');});
if(current?.ruta.length){const points=current.ruta.map(z=>graph[z].join(',')).join(' ');add('polyline',{points,class:'route'});}
S.zonas.forEach((name,z)=>{const [x,y]=graph[z];buttonMap('Zona '+z+': '+name,x,y,z,()=>{zone=z;selected=0;placeId=0;save();render();},zone===z);if($('map').clientWidth>800)add('text',{x,y:y+46,'text-anchor':'middle',class:'zone-label'},name.length>23?'Centro de salud':name);const list=filtered.filter(i=>i.zona===z);if(list.length)add('text',{x,y:y-36*markerScale,'text-anchor':'middle',fill:'#b83c2e','font-size':12*markerScale},list.length+' incidencia'+(list.length===1?'':'s'));zoneButton(z,name,()=>{zone=z;selected=0;save();render();});});
$('disclaimer').textContent='Distribución esquemática de las ocho zonas de la consigna. La ruta resaltada es la registrada al asignar; puede incluir una vía cerrada posteriormente. Los números del catálogo real son independientes de estas zonas.';
}
const place=pmap.get(placeId);$('placeId-info').textContent=place?[place.nombre,place.bloque,place.planta].filter(Boolean).join(' · '):'205 lugares del catálogo. Elegí uno para ver su posición.';renderLocations();detail();
}
function zoneButton(n,name,fn){const b=document.createElement('button');const number=document.createElement('b');number.textContent=n;b.append(number,document.createTextNode(name));b.onclick=fn;$('zones').append(b);}
$('campus').onclick=()=>{mode='campus';save();render();};$('grafo').onclick=()=>{mode='grafo';save();render();};$('refresh').onclick=()=>locationReload();
function locationReload(){save();window.location.reload();}
$('state').onchange=()=>{save();render();};$('search').oninput=renderLocations;$('locations').onchange=e=>choosePlace(e.target.value);
window.addEventListener('resize',()=>render());
render();
// Archivo local autosuficiente. La consola reescribe la instantanea tras cada operacion.
setInterval(()=>{if(document.visibilityState==='visible'&&document.activeElement?.tagName!=='INPUT'&&document.activeElement?.tagName!=='SELECT')locationReload();},8000);
</script>
)MAPA"
