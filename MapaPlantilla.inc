<style>
*{box-sizing:border-box}body{margin:0;color:#17302c;background:#f3f6f4;font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}button,input,select{font:inherit}button,a{touch-action:manipulation}button{cursor:pointer}header{padding:22px 30px;background:#123e33;color:white;display:flex;justify-content:space-between;align-items:center;gap:20px}header small{color:#b4d8cb;letter-spacing:.15em}h1{font-size:24px;margin:2px 0}header a{color:#d2eee1}main{max-width:1550px;margin:auto;padding:24px;display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px}button{border:1px solid #cbd8d1;border-radius:9px;padding:9px 13px;color:#234b3d;background:white}button[aria-pressed=true]{background:#165c46;color:white;border-color:#165c46}input,select{padding:10px;border:1px solid #cbd8d1;border-radius:8px;min-width:0;background:white}input{width:100%}select{max-width:100%}.map-shell{position:relative;background:#e8f0e9;border:1px solid #cbd8d1;border-radius:16px;overflow:hidden}.map-heading{padding:18px 20px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}h2{font-size:18px;margin:0}p{margin:5px 0 14px}.muted{color:#60756b;font-size:13px}.map-canvas{display:block;width:100%;height:auto;aspect-ratio:1120/540}.map-canvas text{font-family:inherit}.map-canvas [role=button]{cursor:pointer;outline:none}.map-canvas [role=button]:focus circle{stroke:#111;stroke-width:4}.map-canvas .zone{fill:#fff;stroke:#5f8975;stroke-width:2}.map-canvas .chosen{fill:#1a654d;stroke:#0d3d2e}.map-canvas .chosen-text{fill:#fff}.map-canvas .edge{stroke:#b2c8b9;stroke-width:3}.map-canvas .route{stroke:#cc5b31;stroke-width:7;fill:none}.map-canvas .alert-pin{fill:#c54536;stroke:white;stroke-width:3}.map-canvas .selected-pin{fill:#b34c26;stroke:white;stroke-width:3}.zone-label{fill:#415a4d;font-size:15px}.legend{padding:14px 20px;display:flex;gap:18px;flex-wrap:wrap;border-top:1px solid #cbd8d1;font-size:13px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}.zone-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:16px}.zone-list button{text-align:left;font-size:13px}.zone-list b{display:inline-flex;width:25px;height:25px;align-items:center;justify-content:center;border-radius:50%;background:#e3eee6;margin-right:6px;color:#174936}aside{min-width:0}.panel{background:white;border:1px solid #d8e1da;border-radius:13px;padding:18px;margin-bottom:15px}.panel label{display:block;font-size:13px;margin:10px 0 5px}.incidents{max-height:340px;overflow:auto}.incident{display:block;width:100%;text-align:left;margin-top:9px;border-radius:9px}.incident strong{font-size:15px}.tag{display:inline-block;font-size:11px;letter-spacing:.02em;color:#9e392c;background:#fff1eb;padding:3px 6px;border-radius:5px}.empty{padding:18px 0;color:#60756b}.detail{overflow-wrap:anywhere}.detail h3{margin:0 0 10px}.detail dl{display:grid;grid-template-columns:100px 1fr;font-size:13px;gap:8px;margin:14px 0}.detail dt{color:#60756b}.detail dd{margin:0}.note{font-size:12px;color:#60756b;margin:14px 2px}.action{background:#eaf2ec;padding:10px;border-radius:8px;color:#335a48;font-size:13px}footer{padding:0 26px 22px;color:#60756b;font-size:12px}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:1000px){main{grid-template-columns:1fr}.map-canvas{height:auto}aside{display:grid;grid-template-columns:1fr 1fr;gap:15px}.panel{margin:0}.detail-panel{grid-column:1/-1}}@media(max-width:600px){header{padding:15px;align-items:flex-start}header a{font-size:12px}main{padding:12px;gap:14px}aside{display:block}.panel{margin-bottom:12px}.map-canvas{height:auto}.map-heading{padding:14px 12px 0}.legend{padding:12px}.zone-list{grid-template-columns:1fr 1fr}.zone-list button{font-size:12px;padding:8px}h1{font-size:21px}}
